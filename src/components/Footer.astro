---
import { FOOTER, SITE } from '../data/site';
import Logo from './Logo.astro';
---
<footer class="border-t border-line bg-bg-muted">
  <div class="container-page py-14">
    <Logo showText={false} />
    <div class="mt-8 grid grid-cols-2 gap-8 md:grid-cols-4">
      {FOOTER.map((col) => (
        <div>
          <h2 class="mb-4 text-lg font-semibold">{col.title}</h2>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-fg-muted hover:text-brand">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-12 text-sm text-fg-muted">
      © {new Date().getFullYear()} {SITE.name}. Dữ liệu kanji từ các dự án mã nguồn mở – xem{' '}
      <a href="/credits" class="link-underline">nguồn dữ liệu</a>.
    </p>
  </div>
</footer>
