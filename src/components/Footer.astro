---
import { SITE, footer } from '../data/site';
import { getLang, localize } from '../i18n';

const lang = getLang(Astro);
import Logo from './Logo.astro';
---
<footer class="border-t border-line bg-bg-muted">
  <div class="container-page py-14">
    <Logo showText={false} />
    <div class="mt-8 grid grid-cols-2 gap-8 md:grid-cols-4">
      {footer(lang).map((col) => (
        <div>
          <h2 class="mb-4 text-lg font-semibold">{col.title}</h2>
          <ul class="space-y-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-fg-muted hover:text-brand">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-12 text-sm text-fg-muted">
      © {new Date().getFullYear()} {SITE.name}.{' '}
      {lang === 'en' ? (
        <>Kanji data from open-source projects – see <a href={localize('/credits', lang)} class="link-underline">credits</a>.</>
      ) : lang === 'zh' ? (
        <>汉字数据来自开源项目，详见<a href={localize('/credits', lang)} class="link-underline">数据来源</a>。</>
      ) : lang === 'id' ? (
        <>Data kanji dari proyek sumber terbuka – lihat <a href={localize('/credits', lang)} class="link-underline">sumber data</a>.</>
      ) : lang === 'ko' ? (
        <>한자 데이터는 오픈 소스 프로젝트에서 가져왔습니다. <a href={localize('/credits', lang)} class="link-underline">데이터 출처</a>를 참고하세요.</>
      ) : (
        <>Dữ liệu kanji từ các dự án mã nguồn mở – xem <a href={localize('/credits', lang)} class="link-underline">nguồn dữ liệu</a>.</>
      )}
    </p>
  </div>
</footer>
