---
interface Props { class?: string; id?: string }
const { class: className = '', id = 'q' } = Astro.props;
---
<form action="/kanji/search" method="get" role="search" class={`relative ${className}`}>
  <label for={id} class="sr-only">Tìm kanji</label>
  <svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-fg-muted" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
  </svg>
  <input
    id={id}
    name="q"
    type="search"
    placeholder="Tìm kanji, nghĩa, âm đọc…"
    class="h-10 w-full rounded-lg border border-line bg-surface pr-3 pl-9 text-sm placeholder:text-fg-muted focus:border-brand focus:outline-none"
  />
</form>
