---
// Danh sách kanji, xem dạng lưới hoặc bảng. Lựa chọn được nhớ cho mọi danh sách.
// Các dòng của bảng nằm trong <template> và chỉ được dựng khi chuyển sang chế độ bảng,
// để trang danh sách dài (N1 có hơn 1.200 chữ) không phải dựng gấp đôi số phần tử.
import { type Kanji, LOCAL_READING_LABEL, kanjiCount, kanjiUrl, kunPlain, localReadings, meaningText, shortLabel } from '../data/kanji';
import { getLang, pick } from '../i18n';
interface Props {
  kanji: Kanji[];
  showToggle?: boolean;
  /** Hiện nút sắp xếp theo tần suất / số nét / cấp JLPT (sắp xếp trên trình duyệt). */
  sortable?: boolean;
}
const { kanji, showToggle = true, sortable = false } = Astro.props;
// Khoá sắp xếp gắn vào từng ô: thứ tự gốc (tần suất), số nét, cấp JLPT (N5 trước, ngoài JLPT cuối).
const sortData = (k: Kanji, i: number) => ({ 'data-i': i, 'data-s': k.strokes, 'data-j': k.jlpt ? 6 - k.jlpt : 9 });
// Danh sách dài được chia trang ngay trên trình duyệt (không tạo thêm file). Mọi ô vẫn nằm trong HTML
// để máy tìm kiếm thấy đủ link; ô ngoài trang hiện tại có data-off và bị ẩn bằng CSS.
const PAGE_SIZE = 60;
const paged = kanji.length > PAGE_SIZE + 20;
const off = (i: number) => (paged && i >= PAGE_SIZE ? { 'data-off': '' } : {});
const lang = getLang(Astro);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });
// Cột âm đọc của người học: Hán Việt (vi), pinyin (zh), âm Hán-Hàn (ko); bản tiếng Anh không có.
const readingLabel = LOCAL_READING_LABEL[lang];
---
<div class="kanji-list" data-view="grid" data-page-size={paged ? PAGE_SIZE : undefined}>
  {showToggle && (
    <div class="mb-5 flex items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-sm text-fg-muted">{kanjiCount(kanji.length, lang)}</p>
        {sortable && (
          <div class="inline-flex rounded-lg border border-line p-0.5 text-sm" role="group" aria-label={t('Sắp xếp', 'Sort', '排序', '정렬', 'Urutkan')}>
            <button type="button" data-sort="i" aria-pressed="true" class="rounded-md px-3 py-1 aria-pressed:bg-bg-muted aria-pressed:font-semibold">{t('Tần suất', 'Frequency', '频率', '빈도', 'Frekuensi')}</button>
            <button type="button" data-sort="s" class="rounded-md px-3 py-1 aria-pressed:bg-bg-muted aria-pressed:font-semibold">{t('Số nét', 'Strokes', '笔画', '획수', 'Goresan')}</button>
            <button type="button" data-sort="j" class="rounded-md px-3 py-1 aria-pressed:bg-bg-muted aria-pressed:font-semibold">JLPT</button>
          </div>
        )}
      </div>
      <div class="inline-flex rounded-lg border border-line p-0.5 text-sm" role="group" aria-label={t('Kiểu hiển thị', 'View', '显示方式', '보기 방식', 'Tampilan')}>
        <button type="button" data-set-view="grid" class="rounded-md px-3 py-1 aria-pressed:bg-bg-muted aria-pressed:font-semibold">{t('Lưới', 'Grid', '网格', '격자', 'Kisi')}</button>
        <button type="button" data-set-view="table" class="rounded-md px-3 py-1 aria-pressed:bg-bg-muted aria-pressed:font-semibold">{t('Bảng', 'Table', '表格', '표', 'Tabel')}</button>
      </div>
    </div>
  )}

  <ul class="view-grid grid grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))] gap-2">
    {kanji.map((k, i) => (
      <li {...sortData(k, i)} {...off(i)}>
        <a
          href={kanjiUrl(k.c, lang)}
          title={meaningText(k, lang)}
          class="flex aspect-square flex-col items-center justify-center rounded-lg border border-line bg-surface transition hover:border-brand/60 hover:text-brand"
        >
          <span lang="ja" class="font-jp text-3xl leading-none">{k.c}</span>
          <span class="mt-2 max-w-full truncate px-1 text-xs text-fg-muted">{shortLabel(k, lang)}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="view-table overflow-x-auto rounded-lg border border-line">
    <table class="w-full min-w-[40rem] text-left text-sm">
      <thead class="bg-bg-muted text-fg-muted">
        <tr>
          <th class="px-4 py-2.5 font-semibold">{t('Kanji', 'Kanji', '汉字', '한자', 'Kanji')}</th>
          {readingLabel && <th class="px-4 py-2.5 font-semibold">{readingLabel}</th>}
          <th class="px-4 py-2.5 font-semibold">{t('Nghĩa', 'Meaning', '释义', '뜻', 'Arti')}</th>
          <th class="px-4 py-2.5 font-semibold">{t('Onyomi', "On'yomi", '音读', '음독', "On'yomi")}</th>
          <th class="px-4 py-2.5 font-semibold">{t('Kunyomi', "Kun'yomi", '训读', '훈독', "Kun'yomi")}</th>
          <th class="px-4 py-2.5 text-right font-semibold">{t('Nét', 'Strokes', '笔画', '획수', 'Goresan')}</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <template>
      {kanji.map((k, i) => (
        <tr {...sortData(k, i)} {...off(i)} class="border-t border-line hover:bg-bg-muted/60">
          <td class="px-4 py-2"><a href={kanjiUrl(k.c, lang)} lang="ja" class="font-jp text-2xl hover:text-brand">{k.c}</a></td>
          {readingLabel && <td class="px-4 py-2 font-semibold">{localReadings(k, lang)?.join(', ')}</td>}
          <td class="px-4 py-2 text-fg-muted">{meaningText(k, lang)}</td>
          <td class="px-4 py-2" lang="ja">{k.on.join('、')}</td>
          <td class="px-4 py-2" lang="ja">{kunPlain(k).slice(0, 4).join('、')}</td>
          <td class="px-4 py-2 text-right tabular-nums">{k.strokes}</td>
        </tr>
      ))}
    </template>
  </div>
  {paged && (
    <nav
      class="pager mt-6 flex flex-wrap items-center justify-center gap-1 text-sm"
      aria-label={t('Phân trang', 'Pagination', '分页', '페이지 이동', 'Halaman')}
      data-prev={t('Trang trước', 'Previous page', '上一页', '이전 페이지', 'Halaman sebelumnya')}
      data-next={t('Trang sau', 'Next page', '下一页', '다음 페이지', 'Halaman berikutnya')}
    ></nav>
  )}
</div>

<style>
  .kanji-list[data-view='grid'] .view-table,
  .kanji-list[data-view='table'] .view-grid,
  .kanji-list [data-off] {
    display: none;
  }
</style>

<script>
  const KEY = 'kanji-view';
  function apply(view: string) {
    document.querySelectorAll<HTMLElement>('.kanji-list').forEach((el) => {
      el.dataset.view = view;
      const tpl = el.querySelector<HTMLTemplateElement>('.view-table template');
      if (view === 'table' && tpl) {
        el.querySelector('.view-table tbody')!.append(tpl.content);
        tpl.remove();
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-set-view]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.setView === view)),
    );
  }
  // Sắp xếp các ô (và các dòng bảng, kể cả dòng còn trong <template>) theo khoá đã chọn.
  function sortList(list: HTMLElement, key: string) {
    const byKey = (a: Element, b: Element) =>
      Number((a as HTMLElement).dataset[key]) - Number((b as HTMLElement).dataset[key]) ||
      Number((a as HTMLElement).dataset.i) - Number((b as HTMLElement).dataset.i);
    for (const box of [list.querySelector('.view-grid'), list.querySelector('.view-table tbody'), list.querySelector<HTMLTemplateElement>('.view-table template')?.content]) {
      if (box) box.append(...[...box.children].sort(byKey));
    }
    list.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === key)));
    paginate(list, 1);
  }

  // ---------- Phân trang ----------
  function paginate(list: HTMLElement, page: number, scroll = false) {
    const size = Number(list.dataset.pageSize);
    if (!size) return;
    const total = list.querySelector('.view-grid')!.children.length;
    const pages = Math.ceil(total / size);
    page = Math.min(Math.max(page, 1), pages);
    for (const box of [list.querySelector('.view-grid'), list.querySelector('.view-table tbody'), list.querySelector<HTMLTemplateElement>('.view-table template')?.content]) {
      if (!box) continue;
      [...box.children].forEach((el, i) => el.toggleAttribute('data-off', i < (page - 1) * size || i >= page * size));
    }
    renderPager(list, page, pages);
    if (scroll && list.getBoundingClientRect().top < 0) list.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  /** Nút trang: ‹ 1 … 4 5 6 … 21 › */
  function renderPager(list: HTMLElement, page: number, pages: number) {
    const nav = list.querySelector<HTMLElement>('.pager');
    if (!nav) return;
    const nums = [...new Set([1, page - 1, page, page + 1, pages])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
    const items: (number | '…')[] = [];
    nums.forEach((n, i) => {
      if (i && n - nums[i - 1] > 1) items.push('…');
      items.push(n);
    });
    const button = (label: string, target: number, opts: { current?: boolean; disabled?: boolean; aria?: string } = {}) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = label;
      b.className = 'min-w-9 rounded-md border border-line px-3 py-1.5 tabular-nums hover:border-brand disabled:opacity-40 aria-[current=page]:border-brand aria-[current=page]:bg-brand aria-[current=page]:text-white';
      if (opts.current) b.setAttribute('aria-current', 'page');
      if (opts.aria) b.setAttribute('aria-label', opts.aria);
      b.disabled = !!opts.disabled;
      b.addEventListener('click', () => paginate(list, target, true));
      return b;
    };
    nav.replaceChildren(
      button('‹', page - 1, { disabled: page === 1, aria: nav.dataset.prev }),
      ...items.map((n) => {
        if (n === '…') {
          const span = document.createElement('span');
          span.className = 'px-1 text-fg-muted';
          span.textContent = '…';
          return span;
        }
        return button(String(n), n, { current: n === page });
      }),
      button('›', page + 1, { disabled: page === pages, aria: nav.dataset.next }),
    );
  }
  document.querySelectorAll<HTMLElement>('.kanji-list[data-page-size]').forEach((list) => paginate(list, 1));
  document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) =>
    b.addEventListener('click', () => sortList(b.closest('.kanji-list')!, b.dataset.sort!)),
  );

  let saved = 'grid';
  try { saved = localStorage.getItem(KEY) || 'grid'; } catch {}
  apply(saved);
  document.querySelectorAll<HTMLButtonElement>('[data-set-view]').forEach((b) =>
    b.addEventListener('click', () => {
      apply(b.dataset.setView!);
      try { localStorage.setItem(KEY, b.dataset.setView!); } catch {}
    }),
  );
</script>
