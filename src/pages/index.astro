---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardLink from '../components/CardLink.astro';
import HeroGrid from '../components/HeroGrid.astro';
import { JLPT_LEVELS, THEMES, byJlpt, jlptSlug } from '../data/kanji';
import { SITE } from '../data/site';
import { getLang, linker, pick } from '../i18n';

const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(l('/'), Astro.site).href,
  inLanguage: lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL(l('/kanji/search'), Astro.site).href}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-line">
    <HeroGrid />
    <div class="container-page relative py-20 md:py-32">
      <div class="max-w-xl">
        <h1 class="text-4xl leading-tight font-bold text-balance md:text-[42px]">
          {t('Danh sách kanji và công cụ cho người học tiếng Nhật.', 'Kanji lists and tools for Japanese learners.')}
        </h1>
        <p class="mt-6 text-lg text-fg-muted md:text-xl">{SITE.description[lang]}</p>
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-20">
    <h2 class="text-2xl font-bold">{t('Danh sách kanji', 'Kanji lists')}</h2>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {JLPT_LEVELS.map((n) => (
        <CardLink href={l(`/kanji/jlpt/${jlptSlug(n)}`)} title={`JLPT N${n}`} subtitle={`${byJlpt(n).length} kanji`} />
      ))}
    </div>
    {lang === 'en' ? (
      <p class="mt-8 text-fg-muted">
        You can also browse kanji by <a href={l('/kanji/kanken')} class="link-underline text-fg">Kanken level</a>,{' '}
        <a href={l('/kanji/radicals')} class="link-underline text-fg">radical</a>, or see the full list of{' '}
        <a href={l('/kanji/all')} class="link-underline text-fg">jōyō kanji</a>.
      </p>
    ) : (
      <p class="mt-8 text-fg-muted">
        Bạn cũng có thể xem kanji theo <a href={l('/kanji/kanken')} class="link-underline text-fg">cấp Kanken</a>,{' '}
        <a href={l('/kanji/radicals')} class="link-underline text-fg">bộ thủ</a>, hoặc xem toàn bộ danh sách{' '}
        <a href={l('/kanji/all')} class="link-underline text-fg">kanji jōyō</a>.
      </p>
    )}
  </section>

  <section class="border-t border-dashed border-line">
    <div class="container-page py-16 md:py-20">
      <h2 class="text-2xl font-bold">{t('Kanji theo chủ đề', 'Kanji by theme')}</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {THEMES.map((th) => (
          <CardLink
            href={l(`/kanji/themes/${th.slug}`)}
            title={th.name[lang]}
            subtitle={`${th.kanji.length} kanji · ${th.kanji.slice(0, 5).map((k) => k.c).join(' ')}…`}
          />
        ))}
      </div>
      <a href={l('/kanji/themes')} class="link-underline mt-8 inline-block">{t('Xem tất cả chủ đề', 'Browse all kanji themes')}</a>
    </div>
  </section>
</BaseLayout>
