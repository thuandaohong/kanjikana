---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { RADICALS, radicalName, radicalTitle } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return RADICALS.filter((r) => r.kanji.length > 0).map((r) => ({ params: { n: String(r.n) }, props: { r } }));
}
const { r } = Astro.props;
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });
const prev = RADICALS.slice(0, r.n - 1).findLast((x) => x.kanji.length > 0);
const next = RADICALS.slice(r.n).find((x) => x.kanji.length > 0);
---
<BaseLayout
  title={`${radicalTitle(r, lang)} ${r.char}`}
  description={t(
    `Bộ thủ số ${r.n}: ${r.char} (${r.name}), gồm ${r.kanji.length} kanji.`,
    `Kangxi radical ${r.n}: ${r.char} (“${r.nameEn}”), with ${r.kanji.length} kanji.`,
  )}
>
  <PageHeader
    title={radicalTitle(r, lang)}
    crumbs={[{ label: 'Kanji', href: l('/kanji') }, { label: t('Bộ thủ', 'Radicals'), href: l('/kanji/radicals') }, { label: radicalName(r, lang) }]}
  >
    <div class="mt-6 flex items-center gap-5">
      <span lang="ja" class="grid size-24 place-items-center rounded-xl border border-line bg-surface font-jp text-6xl">{r.char}</span>
      <p class="text-fg-muted">
        {t(`Bộ thủ số ${r.n}`, `Radical no. ${r.n}`)}
        {lang === 'en' && <> · Hán Việt: {r.name}</>}
        <br />{t(`${r.kanji.length} kanji trong danh sách`, `${r.kanji.length} kanji in our lists`)}
      </p>
    </div>
  </PageHeader>
  <section class="container-page py-10">
    <KanjiList kanji={r.kanji} />
    <nav class="mt-10 flex justify-between text-sm">
      {prev ? <a href={l(`/kanji/radicals/${prev.n}`)} class="link-underline">← {radicalTitle(prev, lang)} <span lang="ja">{prev.char}</span></a> : <span />}
      {next && <a href={l(`/kanji/radicals/${next.n}`)} class="link-underline">{radicalTitle(next, lang)} <span lang="ja">{next.char}</span> →</a>}
    </nav>
  </section>
</BaseLayout>
