---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getLang, linker, pick } from '../../i18n';

const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });
// Chuỗi cho script phía trình duyệt; {n}, {q}, {max}, {chars} được thay khi hiển thị.
const strings = {
  lang,
  kanjiBase: l('/kanji/'),
  loading: t('Đang tải dữ liệu…', 'Loading data…', '正在加载数据…', '데이터를 불러오는 중…', 'Memuat data…'),
  idle: t('Có {n} kanji trong dữ liệu. Hãy nhập từ khoá.', '{n} kanji available. Type something to search.', '共有 {n} 个汉字，请输入关键词。', '한자 {n}자가 있습니다. 검색어를 입력하세요.', 'Tersedia {n} kanji. Ketik kata kunci untuk mencari.'),
  none: t('Không tìm thấy kết quả cho “{q}”.', 'No results for “{q}”.', '没有找到“{q}”的结果。', '“{q}”에 대한 결과가 없습니다.', 'Tidak ada hasil untuk “{q}”.'),
  count: t('{n} kết quả', '{n} results', '{n} 个结果', '결과 {n}개', '{n} hasil'),
  countOne: t('1 kết quả', '1 result', '1 个结果', '결과 1개', '1 hasil'),
  truncated: t(' (hiển thị {max} kết quả đầu)', ' (showing the first {max})', '（显示前 {max} 个）', ' (처음 {max}개 표시)', ' (menampilkan {max} hasil pertama)'),
  missing: t('Chưa có dữ liệu cho: {chars}', 'No data yet for: {chars}', '暂无以下汉字的数据：{chars}', '데이터가 없는 한자: {chars}', 'Belum ada data untuk: {chars}'),
  error: t('Không tải được dữ liệu. Hãy thử tải lại trang.', 'Could not load data. Please reload the page.', '无法加载数据，请刷新页面重试。', '데이터를 불러오지 못했습니다. 페이지를 새로고침해 주세요.', 'Gagal memuat data. Silakan muat ulang halaman.'),
};
const examples = pick(lang, {
  vi: ['hoc', 'thủy', 'tree', 'やま', 'kaku', '日本語を勉強します'],
  en: ['water', 'tree', 'やま', 'kaku', 'manabu', '日本語を勉強します'],
  zh: ['xue', 'shui', 'tree', 'やま', 'kaku', '日本語を勉強します'],
  ko: ['학', '수', 'tree', 'やま', 'kaku', '日本語を勉強します'],
  id: ['water', 'tree', 'やま', 'kaku', 'manabu', '日本語を勉強します'],
});
---
<BaseLayout
  title={t('Tìm kanji', 'Kanji search', '汉字搜索', '한자 검색', 'Cari kanji')}
  description={t(
    'Tìm kanji theo chữ, âm Hán Việt (có dấu hoặc không dấu), nghĩa tiếng Anh, âm On/Kun hoặc romaji.',
    'Search kanji by character, English meaning, or on/kun reading in kana or romaji.',
    '按汉字、拼音、英文释义、假名或罗马字的音读/训读搜索日语汉字。',
    '한자, 한국 한자음, 영어 뜻, 가나나 로마자로 쓴 음독·훈독으로 일본 한자를 검색합니다.',
    'Cari kanji berdasarkan huruf, arti dalam bahasa Inggris, atau cara baca on/kun dalam kana maupun romaji.',
  )}
>
  <script is:inline type="application/json" id="page-strings" set:html={JSON.stringify(strings)} />
  <PageHeader
    title={t('Tìm kanji', 'Kanji search', '汉字搜索', '한자 검색', 'Cari kanji')}
    crumbs={[{ label: t('Kanji', 'Kanji', '汉字', '한자', 'Kanji'), href: l('/kanji') }, { label: t('Tìm kiếm', 'Search', '搜索', '검색', 'Cari') }]}
    lead={t(
      'Gõ âm Hán Việt (có dấu hoặc không), nghĩa tiếng Anh, cách đọc bằng kana hoặc romaji. Bạn cũng có thể dán cả một câu tiếng Nhật để liệt kê các kanji trong đó.',
      'Type an English meaning or a reading in kana or romaji. You can also paste a Japanese sentence to list the kanji it contains.',
      '输入拼音（可不带声调）、英文释义，或用假名、罗马字输入读音。也可以粘贴一句日语，列出其中的汉字。',
      '한국 한자음(예: 학), 영어 뜻, 가나나 로마자로 쓴 읽기를 입력하세요. 일본어 문장을 붙여 넣으면 그 안의 한자를 모두 보여 줍니다.',
      'Ketik arti dalam bahasa Inggris, atau cara baca dalam kana maupun romaji. Kamu juga bisa menempelkan kalimat bahasa Jepang untuk melihat semua kanji di dalamnya.',
    )}
  >
    <form id="search-form" class="relative mt-6 max-w-2xl" role="search">
      <label for="search-q" class="sr-only">{t('Từ khoá', 'Search term', '关键词', '검색어', 'Kata kunci')}</label>
      <input
        id="search-q"
        name="q"
        type="search"
        autocomplete="off"
        autofocus
        placeholder={t('Ví dụ: hoc, thủy, water, がく, manabu, 日本語…', 'e.g. water, がく, manabu, 日本語…', '例如：xue、water、がく、manabu、日本語…', '예: 학, water, がく, manabu, 日本語…', 'mis. water, がく, manabu, 日本語…')}
        class="h-12 w-full rounded-xl border border-line bg-surface px-4 text-lg placeholder:text-fg-muted focus:border-brand focus:outline-none"
      />
    </form>
    <p class="mt-3 text-sm text-fg-muted">
      {t('Thử:', 'Try:', '试试：', '예시:', 'Coba:')}{' '}
      {examples.map((s, i) => (
        <>{i > 0 && ' · '}<button type="button" data-example={s} class="link-underline">{s}</button></>
      ))}
    </p>
  </PageHeader>

  <section class="container-page py-10">
    <p id="search-status" class="mb-5 text-sm text-fg-muted" aria-live="polite">{strings.loading}</p>
    <ul id="search-results" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
  </section>
</BaseLayout>

<script>
  import { foldVi, toHiragana } from '../../lib/text';

  type Entry = {
    c: string; hv: string[]; py: string[]; ko: string[]; en: string[]; on: string[]; kun: string[];
    jlpt: number | null; grade: number | null; strokes: number; hvf: string[]; pyf: string[]; ro: string[];
    /** Nghĩa đã dịch theo ngôn ngữ của trang (tải riêng), và bản không dấu từng nghĩa để tìm kiếm */
    m?: string; mf?: string[];
  };

  const S = JSON.parse(document.getElementById('page-strings')!.textContent!);
  const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k]));
  const MAX = 120;
  const input = document.getElementById('search-q') as HTMLInputElement;
  const status = document.getElementById('search-status')!;
  const list = document.getElementById('search-results')!;

  const CJK = /[㐀-鿿豈-﫿]/g;
  const KANA = /^[ぁ-ヿー]+$/;
  const HANGUL = /^[가-힣\s]+$/;

  let data: Entry[] = [];
  let byChar = new Map<string, Entry>();

  function scoreLatin(k: Entry, token: string): number {
    let s = 0;
    // Âm Hán Việt chỉ tính ở bản tiếng Việt.
    for (const h of S.lang === 'vi' ? k.hvf : []) {
      if (h === token) s = Math.max(s, 100);
      else if (h.startsWith(token)) s = Math.max(s, 40);
    }
    // Pinyin chỉ tính ở bản tiếng Trung, vì các âm ngắn (li, shi…) trùng với rất nhiều chữ.
    if (S.lang === 'zh') {
      for (const p of k.pyf) {
        if (p === token) s = Math.max(s, 95);
        else if (token.length >= 2 && p.startsWith(token)) s = Math.max(s, 35);
      }
    }
    for (const r of k.ro) {
      if (r === token) s = Math.max(s, 90);
      else if (token.length >= 2 && r.startsWith(token)) s = Math.max(s, 30);
    }
    // Nghĩa đã dịch (tiếng Việt, Indonesia): khớp cả nghĩa hoặc một từ trong nghĩa.
    for (const m of k.mf ?? []) {
      if (m === token) s = Math.max(s, 85);
      else if (m.split(/\s+/).includes(token)) s = Math.max(s, 70);
      else if (token.length >= 4 && m.includes(token)) s = Math.max(s, 15);
    }
    for (const m of k.en) {
      const words = m.toLowerCase().split(/[^a-z]+/);
      if (m.toLowerCase() === token) s = Math.max(s, 85);
      else if (words.includes(token)) s = Math.max(s, 70);
      else if (token.length >= 4 && m.toLowerCase().includes(token)) s = Math.max(s, 15);
    }
    return s;
  }

  function scoreKana(k: Entry, q: string): number {
    let s = 0;
    for (const r of [...k.on, ...k.kun].map((x) => toHiragana(x).replace(/-/g, ''))) {
      if (r === q) s = Math.max(s, 100);
      else if (r.startsWith(q)) s = Math.max(s, 40);
    }
    return s;
  }

  function search(raw: string): { results: Entry[]; note?: string } {
    const q = raw.trim();
    if (!q) return { results: [] };

    // Có chữ Hán: liệt kê các kanji trong chuỗi theo thứ tự xuất hiện.
    const chars = [...new Set(q.match(CJK) ?? [])];
    if (chars.length) {
      const found = chars.map((c) => byChar.get(c)).filter((k): k is Entry => !!k);
      const missing = chars.filter((c) => !byChar.has(c));
      return {
        results: found,
        note: missing.length ? fill(S.missing, { chars: missing.join(' ') }) : undefined,
      };
    }

    let scored: [Entry, number][];
    if (HANGUL.test(q)) {
      // Âm Hán-Hàn: mỗi âm tiết hangul là một từ khoá ("학생" → 학, 생).
      const tokens = [...q.replace(/\s+/g, '')];
      // Cả chuỗi khớp một nghĩa tiếng Hàn ("배우다") thì xếp trên mọi kết quả khớp âm theo từng âm tiết.
      const whole = q.replace(/\s+/g, '');
      const meaningScore = (k: Entry) => {
        if (whole.length < 2 || !k.mf) return 0;
        const senses = k.mf.map((m) => m.replace(/\s+/g, ''));
        return senses.includes(whole) ? 1000 : senses.some((m) => m.startsWith(whole)) ? 500 : 0;
      };
      scored = data.map((k) => [k, tokens.reduce((sum, t) => sum + (k.ko.includes(t) ? 100 : 0), 0) + meaningScore(k)]);
    } else if (KANA.test(q)) {
      const h = toHiragana(q);
      scored = data.map((k) => [k, scoreKana(k, h)]);
    } else {
      // Bỏ dấu, bỏ macron (kō → ko); nhiều từ thì cộng điểm từng từ.
      const tokens = foldVi(q).split(/\s+/).filter(Boolean);
      scored = data.map((k) => [k, tokens.reduce((sum, t) => sum + scoreLatin(k, t), 0)]);
    }
    // Dữ liệu đã xếp theo độ thông dụng, sort ổn định giữ nguyên thứ tự khi bằng điểm.
    return { results: scored.filter(([, s]) => s > 0).sort((a, b) => b[1] - a[1]).map(([k]) => k) };
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
    const e = document.createElement(tag);
    e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function render(q: string) {
    const { results, note } = search(q);
    list.replaceChildren(
      ...results.slice(0, MAX).map((k) => {
        const li = el('li', '');
        const a = el('a', 'flex h-full gap-4 rounded-xl border border-line bg-surface p-4 transition hover:border-brand/60');
        a.href = S.kanjiBase + k.c;
        const big = el('span', 'font-jp text-5xl leading-none', k.c);
        big.lang = 'ja';
        const body = el('div', 'min-w-0 flex-1');
        const head = el('p', 'flex items-baseline justify-between gap-2');
        // Bản vi/zh/ko nổi bật âm đọc của người học (Hán Việt, pinyin, âm Hán-Hàn).
        // Tiếng Anh và tiếng Indonesia không có âm đọc riêng (local là undefined) nên nổi bật nghĩa.
        const local: string[] | undefined = ({ vi: k.hv, zh: k.py, ko: k.ko } as Record<string, string[]>)[S.lang];
        const meaning = k.m ?? k.en.join(', ');
        const title = local ? local.join(', ') : k.m ?? k.en.slice(0, 2).join(', ');
        const sub = local ? meaning : k.m ? '' : k.en.slice(2).join(', ');
        head.append(el('span', 'font-serif text-lg font-bold text-brand', title || '—'));
        if (k.jlpt) head.append(el('span', 'shrink-0 rounded-full bg-bg-muted px-2 py-0.5 text-xs font-semibold text-fg-muted', `N${k.jlpt}`));
        const reading = el('p', 'mt-1 truncate text-sm', [...k.on, ...k.kun].slice(0, 5).join('、'));
        reading.lang = 'ja';
        body.append(head, el('p', 'mt-1 line-clamp-2 text-sm text-fg-muted', sub), reading);
        a.append(big, body);
        li.append(a);
        return li;
      }),
    );
    if (!q.trim()) status.textContent = fill(S.idle, { n: data.length });
    else if (!results.length) status.textContent = fill(S.none, { q }) + (note ? ` ${note}` : '');
    else
      status.textContent =
        (results.length === 1 ? S.countOne : fill(S.count, { n: results.length })) + (results.length > MAX ? fill(S.truncated, { max: MAX }) : '') + (note ? `. ${note}` : '');
  }

  function update(q: string) {
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    render(q);
  }

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  document.getElementById('search-form')!.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', () => update(input.value));
  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.example!;
      update(input.value);
      input.focus();
    }),
  );

  // Bản không phải tiếng Anh tải thêm nghĩa đã dịch của ngôn ngữ đó.
  Promise.all([
    fetch('/data/kanji.json').then((r) => r.json()),
    S.lang === 'en' ? {} : fetch(`/data/meanings/${S.lang}.json`).then((r) => r.json()),
  ])
    .then(([json, meanings]: [{ kanji: Entry[] }, Record<string, string>]) => {
      data = json.kanji;
      for (const k of data) {
        k.m = meanings[k.c];
        k.mf = k.m?.split(/[,、]/).map((x) => foldVi(x.trim())).filter(Boolean);
      }
      byChar = new Map(data.map((k) => [k.c, k]));
      render(input.value);
    })
    .catch(() => (status.textContent = S.error));
</script>
