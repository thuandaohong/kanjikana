---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getLang, linker, pick } from '../../i18n';

const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });
// Chuỗi cho script phía trình duyệt; {n}, {q}, {max}, {chars} được thay khi hiển thị.
const strings = {
  lang,
  kanjiBase: l('/kanji/'),
  loading: t('Đang tải dữ liệu…', 'Loading data…'),
  idle: t('Có {n} kanji trong dữ liệu. Hãy nhập từ khoá.', '{n} kanji available. Type something to search.'),
  none: t('Không tìm thấy kết quả cho “{q}”.', 'No results for “{q}”.'),
  count: t('{n} kết quả', '{n} results'),
  countOne: t('1 kết quả', '1 result'),
  truncated: t(' (hiển thị {max} kết quả đầu)', ' (showing the first {max})'),
  missing: t('Chưa có dữ liệu cho: {chars}', 'No data yet for: {chars}'),
  error: t('Không tải được dữ liệu. Hãy thử tải lại trang.', 'Could not load data. Please reload the page.'),
};
const examples = lang === 'en' ? ['water', 'tree', 'やま', 'kaku', 'hoc', '日本語を勉強します'] : ['hoc', 'thủy', 'tree', 'やま', 'kaku', '日本語を勉強します'];
---
<BaseLayout
  title={t('Tìm kanji', 'Kanji search')}
  description={t(
    'Tìm kanji theo chữ, âm Hán Việt (có dấu hoặc không dấu), nghĩa tiếng Anh, âm On/Kun hoặc romaji.',
    'Search kanji by character, English meaning, on/kun reading in kana or romaji, or Sino-Vietnamese reading.',
  )}
>
  <script is:inline type="application/json" id="page-strings" set:html={JSON.stringify(strings)} />
  <PageHeader
    title={t('Tìm kanji', 'Kanji search')}
    crumbs={[{ label: 'Kanji', href: l('/kanji') }, { label: t('Tìm kiếm', 'Search') }]}
    lead={t(
      'Gõ âm Hán Việt (có dấu hoặc không), nghĩa tiếng Anh, cách đọc bằng kana hoặc romaji. Bạn cũng có thể dán cả một câu tiếng Nhật để liệt kê các kanji trong đó.',
      'Type an English meaning, a reading in kana or romaji, or a Sino-Vietnamese reading. You can also paste a Japanese sentence to list the kanji it contains.',
    )}
  >
    <form id="search-form" class="relative mt-6 max-w-2xl" role="search">
      <label for="search-q" class="sr-only">{t('Từ khoá', 'Search term')}</label>
      <input
        id="search-q"
        name="q"
        type="search"
        autocomplete="off"
        autofocus
        placeholder={t('Ví dụ: hoc, thủy, water, がく, manabu, 日本語…', 'e.g. water, がく, manabu, 日本語…')}
        class="h-12 w-full rounded-xl border border-line bg-surface px-4 text-lg placeholder:text-fg-muted focus:border-brand focus:outline-none"
      />
    </form>
    <p class="mt-3 text-sm text-fg-muted">
      {t('Thử:', 'Try:')}{' '}
      {examples.map((s, i) => (
        <>{i > 0 && ' · '}<button type="button" data-example={s} class="link-underline">{s}</button></>
      ))}
    </p>
  </PageHeader>

  <section class="container-page py-10">
    <p id="search-status" class="mb-5 text-sm text-fg-muted" aria-live="polite">{strings.loading}</p>
    <ul id="search-results" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
  </section>
</BaseLayout>

<script>
  import { foldVi, toHiragana } from '../../lib/text';

  type Entry = {
    c: string; hv: string[]; en: string[]; on: string[]; kun: string[];
    jlpt: number | null; grade: number | null; strokes: number; hvf: string[]; ro: string[];
  };

  const S = JSON.parse(document.getElementById('page-strings')!.textContent!);
  const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k]));
  const MAX = 120;
  const input = document.getElementById('search-q') as HTMLInputElement;
  const status = document.getElementById('search-status')!;
  const list = document.getElementById('search-results')!;

  const CJK = /[㐀-鿿豈-﫿]/g;
  const KANA = /^[ぁ-ヿー]+$/;

  let data: Entry[] = [];
  let byChar = new Map<string, Entry>();

  function scoreLatin(k: Entry, token: string): number {
    let s = 0;
    for (const h of k.hvf) {
      if (h === token) s = Math.max(s, 100);
      else if (h.startsWith(token)) s = Math.max(s, 40);
    }
    for (const r of k.ro) {
      if (r === token) s = Math.max(s, 90);
      else if (token.length >= 2 && r.startsWith(token)) s = Math.max(s, 30);
    }
    for (const m of k.en) {
      const words = m.toLowerCase().split(/[^a-z]+/);
      if (m.toLowerCase() === token) s = Math.max(s, 85);
      else if (words.includes(token)) s = Math.max(s, 70);
      else if (token.length >= 4 && m.toLowerCase().includes(token)) s = Math.max(s, 15);
    }
    return s;
  }

  function scoreKana(k: Entry, q: string): number {
    let s = 0;
    for (const r of [...k.on, ...k.kun].map((x) => toHiragana(x).replace(/-/g, ''))) {
      if (r === q) s = Math.max(s, 100);
      else if (r.startsWith(q)) s = Math.max(s, 40);
    }
    return s;
  }

  function search(raw: string): { results: Entry[]; note?: string } {
    const q = raw.trim();
    if (!q) return { results: [] };

    // Có chữ Hán: liệt kê các kanji trong chuỗi theo thứ tự xuất hiện.
    const chars = [...new Set(q.match(CJK) ?? [])];
    if (chars.length) {
      const found = chars.map((c) => byChar.get(c)).filter((k): k is Entry => !!k);
      const missing = chars.filter((c) => !byChar.has(c));
      return {
        results: found,
        note: missing.length ? fill(S.missing, { chars: missing.join(' ') }) : undefined,
      };
    }

    let scored: [Entry, number][];
    if (KANA.test(q)) {
      const h = toHiragana(q);
      scored = data.map((k) => [k, scoreKana(k, h)]);
    } else {
      // Bỏ dấu, bỏ macron (kō → ko); nhiều từ thì cộng điểm từng từ.
      const tokens = foldVi(q).split(/\s+/).filter(Boolean);
      scored = data.map((k) => [k, tokens.reduce((sum, t) => sum + scoreLatin(k, t), 0)]);
    }
    // Dữ liệu đã xếp theo độ thông dụng, sort ổn định giữ nguyên thứ tự khi bằng điểm.
    return { results: scored.filter(([, s]) => s > 0).sort((a, b) => b[1] - a[1]).map(([k]) => k) };
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
    const e = document.createElement(tag);
    e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function render(q: string) {
    const { results, note } = search(q);
    list.replaceChildren(
      ...results.slice(0, MAX).map((k) => {
        const li = el('li', '');
        const a = el('a', 'flex h-full gap-4 rounded-xl border border-line bg-surface p-4 transition hover:border-brand/60');
        a.href = S.kanjiBase + k.c;
        const big = el('span', 'font-jp text-5xl leading-none', k.c);
        big.lang = 'ja';
        const body = el('div', 'min-w-0 flex-1');
        const head = el('p', 'flex items-baseline justify-between gap-2');
        // Bản tiếng Việt nổi bật âm Hán Việt, bản tiếng Anh nổi bật nghĩa.
        const title = S.lang === 'en' ? k.en.slice(0, 2).join(', ') : k.hv.join(', ');
        const sub = S.lang === 'en' ? k.en.slice(2).join(', ') : k.en.join(', ');
        head.append(el('span', 'font-serif text-lg font-bold text-brand', title || '—'));
        if (k.jlpt) head.append(el('span', 'shrink-0 rounded-full bg-bg-muted px-2 py-0.5 text-xs font-semibold text-fg-muted', `N${k.jlpt}`));
        const reading = el('p', 'mt-1 truncate text-sm', [...k.on, ...k.kun].slice(0, 5).join('、'));
        reading.lang = 'ja';
        body.append(head, el('p', 'mt-1 line-clamp-2 text-sm text-fg-muted', sub), reading);
        a.append(big, body);
        li.append(a);
        return li;
      }),
    );
    if (!q.trim()) status.textContent = fill(S.idle, { n: data.length });
    else if (!results.length) status.textContent = fill(S.none, { q }) + (note ? ` ${note}` : '');
    else
      status.textContent =
        (results.length === 1 ? S.countOne : fill(S.count, { n: results.length })) + (results.length > MAX ? fill(S.truncated, { max: MAX }) : '') + (note ? `. ${note}` : '');
  }

  function update(q: string) {
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    render(q);
  }

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  document.getElementById('search-form')!.addEventListener('submit', (e) => e.preventDefault());
  input.addEventListener('input', () => update(input.value));
  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.example!;
      update(input.value);
      input.focus();
    }),
  );

  fetch('/data/kanji.json')
    .then((r) => r.json())
    .then((json) => {
      data = json.kanji;
      byChar = new Map(data.map((k) => [k.c, k]));
      render(input.value);
    })
    .catch(() => (status.textContent = S.error));
</script>
