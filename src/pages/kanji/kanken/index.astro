---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CardLink from '../../../components/CardLink.astro';
import { ALL, KANKEN } from '../../../data/kanji';
---
<BaseLayout title="Kanji theo cấp Kanken" description="Danh sách kanji theo cấp của kỳ thi năng lực Hán tự (Kanken).">
  <PageHeader
    title="Kanji theo cấp Kanken"
    crumbs={[{ label: 'Kanji', href: '/kanji' }, { label: 'Kanken' }]}
    lead="Kanken (漢検 – Kiểm định năng lực Hán tự) là kỳ thi kanji dành cho cả người Nhật, từ cấp 10 (dễ nhất) đến cấp 1."
  />
  <section class="container-page py-12">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {KANKEN.map((g) => (
        <CardLink href={`/kanji/kanken/${g.slug}`} title={g.name} subtitle={`${ALL.filter(g.match).length} kanji · ${g.note}`} />
      ))}
    </div>
    <p class="mt-8 max-w-2xl text-sm text-fg-muted">
      Các cấp 4, 3, 準2 và 2 hiện được gộp chung vì dữ liệu nguồn chưa tách riêng. Cấp 準1 và 1 chỉ gồm những chữ ngoài
      jōyō có trong các danh sách của trang này.
    </p>
  </section>
</BaseLayout>
