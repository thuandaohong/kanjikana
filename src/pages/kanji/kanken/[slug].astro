---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { ALL, KANKEN } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return KANKEN.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}
const { group } = Astro.props;
const kanji = ALL.filter(group.match);
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });
---
<BaseLayout
  title={t(`Kanji Kanken ${group.name}`, `Kanji Kanken ${group.name}`, `汉检 ${group.name} 汉字`, `한자검정 ${group.name} 한자`, `Kanji Kanken ${group.name}`)}
  description={t(`Danh sách ${kanji.length} kanji Kanken ${group.name}.`, `All ${kanji.length} kanji for Kanken ${group.name}.`, `汉检 ${group.name} 全部 ${kanji.length} 个汉字。`, `한자검정 ${group.name} 한자 ${kanji.length}자 전체.`, `Semua ${kanji.length} kanji untuk Kanken ${group.name}.`)}
>
  <PageHeader
    title={t(`Kanken ${group.name}`, `Kanken ${group.name}`, `汉检 ${group.name}`, `한자검정 ${group.name}`, `Kanken ${group.name}`)}
    crumbs={[{ label: t('Kanji', 'Kanji', '汉字', '한자', 'Kanji'), href: l('/kanji') }, { label: t('Kanken', 'Kanken', '汉检', '한자검정', 'Kanken'), href: l('/kanji/kanken') }, { label: group.name }]}
    lead={group.note[lang]}
  >
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={t('Cấp Kanken khác', 'Other Kanken levels', '其他汉检级别', '다른 한자검정 급수', 'Level Kanken lainnya')}>
      {KANKEN.map((g) => (
        <a
          href={l(`/kanji/kanken/${g.slug}`)}
          aria-current={g.slug === group.slug ? 'page' : undefined}
          lang="ja"
          class="rounded-full border border-line px-4 py-1.5 text-sm font-semibold hover:border-brand aria-[current=page]:border-brand aria-[current=page]:bg-brand aria-[current=page]:text-white"
        >{g.name}</a>
      ))}
    </nav>
  </PageHeader>
  <AdSlot placement="list" class="pt-8" />
  <section class="container-page py-10">
    <KanjiList kanji={kanji} />
  </section>
</BaseLayout>
