---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { ALL, KANKEN } from '../../../data/kanji';

export function getStaticPaths() {
  return KANKEN.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}
const { group } = Astro.props;
const kanji = ALL.filter(group.match);
---
<BaseLayout title={`Kanji Kanken ${group.name}`} description={`Danh sách ${kanji.length} kanji Kanken ${group.name}.`}>
  <PageHeader
    title={`Kanken ${group.name}`}
    crumbs={[{ label: 'Kanji', href: '/kanji' }, { label: 'Kanken', href: '/kanji/kanken' }, { label: group.name }]}
    lead={group.note}
  >
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Cấp Kanken khác">
      {KANKEN.map((g) => (
        <a
          href={`/kanji/kanken/${g.slug}`}
          aria-current={g.slug === group.slug ? 'page' : undefined}
          lang="ja"
          class="rounded-full border border-line px-4 py-1.5 text-sm font-semibold hover:border-brand aria-[current=page]:border-brand aria-[current=page]:bg-brand aria-[current=page]:text-white"
        >{g.name}</a>
      ))}
    </nav>
  </PageHeader>
  <section class="container-page py-10">
    <KanjiList kanji={kanji} />
  </section>
</BaseLayout>
