---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { ALL, KANKEN } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return KANKEN.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}
const { group } = Astro.props;
const kanji = ALL.filter(group.match);
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });
---
<BaseLayout
  title={`Kanji Kanken ${group.name}`}
  description={t(`Danh sách ${kanji.length} kanji Kanken ${group.name}.`, `All ${kanji.length} kanji for Kanken ${group.name}.`)}
>
  <PageHeader
    title={`Kanken ${group.name}`}
    crumbs={[{ label: 'Kanji', href: l('/kanji') }, { label: 'Kanken', href: l('/kanji/kanken') }, { label: group.name }]}
    lead={group.note[lang]}
  >
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={t('Cấp Kanken khác', 'Other Kanken levels')}>
      {KANKEN.map((g) => (
        <a
          href={l(`/kanji/kanken/${g.slug}`)}
          aria-current={g.slug === group.slug ? 'page' : undefined}
          lang="ja"
          class="rounded-full border border-line px-4 py-1.5 text-sm font-semibold hover:border-brand aria-[current=page]:border-brand aria-[current=page]:bg-brand aria-[current=page]:text-white"
        >{g.name}</a>
      ))}
    </nav>
  </PageHeader>
  <section class="container-page py-10">
    <KanjiList kanji={kanji} />
  </section>
</BaseLayout>
