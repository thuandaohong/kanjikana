---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CardLink from '../../../components/CardLink.astro';
import { THEMES } from '../../../data/kanji';
---
<BaseLayout title="Kanji theo chủ đề" description="Học kanji theo nhóm chủ đề: số đếm, động vật, thiên nhiên, cơ thể…">
  <PageHeader
    title="Kanji theo chủ đề"
    crumbs={[{ label: 'Kanji', href: '/kanji' }, { label: 'Chủ đề' }]}
    lead="Học kanji theo nhóm nghĩa giúp dễ nhớ và dễ liên tưởng hơn."
  />
  <section class="container-page py-12">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {THEMES.map((t) => (
        <CardLink href={`/kanji/themes/${t.slug}`} title={t.name} subtitle={`${t.kanji.length} kanji · ${t.kanji.slice(0, 5).map((k) => k.c).join(' ')}…`} />
      ))}
    </div>
  </section>
</BaseLayout>
