---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { THEMES } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}
const { theme } = Astro.props;
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });
const name = theme.name[lang];
---
<BaseLayout
  title={t(`Kanji chủ đề ${name}`, `${name} kanji`)}
  description={t(`${theme.kanji.length} kanji thuộc chủ đề ${name}.`, `${theme.kanji.length} kanji about ${name.toLowerCase()}.`)}
>
  <PageHeader
    title={name}
    crumbs={[{ label: 'Kanji', href: l('/kanji') }, { label: t('Chủ đề', 'Themes'), href: l('/kanji/themes') }, { label: name }]}
  />
  <section class="container-page py-10">
    <KanjiList kanji={theme.kanji} />
  </section>
</BaseLayout>
