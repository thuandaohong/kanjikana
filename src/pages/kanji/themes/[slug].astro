---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { THEMES } from '../../../data/kanji';

export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}
const { theme } = Astro.props;
---
<BaseLayout title={`Kanji chủ đề ${theme.name}`} description={`${theme.kanji.length} kanji thuộc chủ đề ${theme.name}.`}>
  <PageHeader
    title={theme.name}
    crumbs={[{ label: 'Kanji', href: '/kanji' }, { label: 'Chủ đề', href: '/kanji/themes' }, { label: theme.name }]}
  />
  <section class="container-page py-10">
    <KanjiList kanji={theme.kanji} />
  </section>
</BaseLayout>
