---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { THEMES } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { slug: t.slug }, props: { theme: t } }));
}
const { theme } = Astro.props;
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });
const name = theme.name[lang];
---
<BaseLayout
  title={t(`Kanji chủ đề ${name}`, `${name} kanji`, `主题汉字：${name}`, `주제별 한자: ${name}`, `Kanji tema ${name}`)}
  description={t(`${theme.kanji.length} kanji thuộc chủ đề ${name}.`, `${theme.kanji.length} kanji about ${name.toLowerCase()}.`, `「${name}」主题的 ${theme.kanji.length} 个汉字。`, `‘${name}’ 주제의 한자 ${theme.kanji.length}자.`, `${theme.kanji.length} kanji bertema ${name.toLowerCase()}.`)}
>
  <PageHeader
    title={name}
    crumbs={[{ label: t('Kanji', 'Kanji', '汉字', '한자', 'Kanji'), href: l('/kanji') }, { label: t('Chủ đề', 'Themes', '主题', '주제', 'Tema'), href: l('/kanji/themes') }, { label: name }]}
  />
  <AdSlot placement="list" class="pt-8" />
  <section class="container-page py-10">
    <KanjiList kanji={theme.kanji} />
  </section>
</BaseLayout>
