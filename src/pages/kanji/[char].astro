---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import KanjiList from '../../components/KanjiList.astro';
import StrokeOrder from '../../components/StrokeOrder.astro';
import StrokeSteps from '../../components/StrokeSteps.astro';
import AdSlot from '../../components/AdSlot.astro';
import { ALL, KANKEN, RADICALS, STROKES, THEMES, VOCAB, gradeLabel, hvText, jlptSlug, kanjiUrl, isThinKanji, localMeaning, meaningText, radicalName, SENTENCES, sentenceTranslation, wordMeaning, type Kanji } from '../../data/kanji';
import { HTML_LANGS } from '../../i18n';
import { getLang, linker, pick } from '../../i18n';

export function getStaticPaths() {
  return ALL.map((k) => ({ params: { char: k.c }, props: { k } }));
}
const { k } = Astro.props as { k: Kanji };
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });

const radical = RADICALS[k.rad - 1];
const kanken = KANKEN.find((g) => g.match(k))!;
const themes = THEMES.filter((th) => th.kanji.some((x) => x.c === k.c));

// Chữ trước/sau trong cùng danh sách JLPT (hoặc cùng cấp lớp nếu không thuộc JLPT).
const siblings = ALL.filter((x) => (k.jlpt ? x.jlpt === k.jlpt : x.grade === k.grade));
const idx = siblings.findIndex((x) => x.c === k.c);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const sameRadical = radical.kanji.filter((x) => x.c !== k.c).slice(0, 24);

const paths = STROKES[k.c] ?? [];
const words = VOCAB[k.c] ?? [];
const sentences = SENTENCES[k.c] ?? [];
const hv = hvText(k);
const py = k.py.join(', ');
const ko = k.ko.join(', ');
// Giữ dấu "." để tô màu phần okurigana, nhưng bỏ các cách đọc trùng khi hiển thị.
const kun = k.kun.filter((r, i) => k.kun.findIndex((x) => x.replace('.', '') === r.replace('.', '')) === i);
// Nghĩa theo ngôn ngữ của trang (dịch từ KANJIDIC2); thiếu bản dịch thì dùng nghĩa tiếng Anh.
const translated = localMeaning(k, lang);
const meaningEn = k.en.join(', ');
const meaning = meaningText(k, lang, 99);
const meaningLang = translated ? HTML_LANGS[lang] : 'en';
const facts: [string, string, string?][] = [
  [t('Số nét', 'Strokes', '笔画数', '획수', 'Goresan'), String(k.strokes)],
  [t('Bộ thủ', 'Radical', '部首', '부수', 'Radikal'), `${radical.char} ${radicalName(radical, lang)} (${radical.n})`, l(`/kanji/radicals/${radical.n}`)],
  ['JLPT', k.jlpt ? `N${k.jlpt}` : '—', k.jlpt ? l(`/kanji/jlpt/${jlptSlug(k.jlpt)}`) : undefined],
  [t('Cấp lớp', 'School grade', '学年', '학년', 'Kelas sekolah'), k.grade ? (k.grade <= 8 ? gradeLabel(k.grade, lang) : t('Jinmeiyō', 'Jinmeiyō', '人名用汉字', '인명용 한자', 'Jinmeiyō')) : '—'],
  [t('Kanken', 'Kanken', '汉检', '한자검정', 'Kanken'), kanken.name, l(`/kanji/kanken/${kanken.slug}`)],
  [t('Tần suất', 'Frequency', '使用频率', '사용 빈도', 'Frekuensi'), k.freq ? `#${k.freq} / 2500` : '—'],
];
---
<BaseLayout
  noindex={isThinKanji(k.c)}
  title={t(`${k.c} – ${hv || meaning}`, `${k.c} – ${k.en.slice(0, 3).join(', ') || k.on[0] || ''}`, `${k.c} – ${py || meaning}`, `${k.c} – ${ko || meaning}`, `${k.c} – ${meaningText(k, lang) || k.on[0] || ''}`)}
  description={t(
    `Kanji ${k.c}${hv ? ` (Hán Việt: ${hv})` : ''}: ${meaning}. Onyomi ${k.on.join('、') || '—'}, kunyomi ${k.kun.join('、') || '—'}, ${k.strokes} nét.`,
    `Kanji ${k.c} means ${meaning || '—'}. On'yomi ${k.on.join('、') || '—'}, kun'yomi ${k.kun.join('、') || '—'}, ${k.strokes} strokes, with stroke order and example words.`,
    `日语汉字 ${k.c}${py ? `（拼音：${py}）` : ''}：${meaning || '—'}。音读 ${k.on.join('、') || '—'}，训读 ${k.kun.join('、') || '—'}，${k.strokes} 画，附笔顺和例词。`,
    `일본 한자 ${k.c}${ko ? `(한자음: ${ko})` : ''}: ${meaning || '—'}. 음독 ${k.on.join('、') || '—'}, 훈독 ${k.kun.join('、') || '—'}, ${k.strokes}획, 획순과 예시 단어.`,
    `Kanji ${k.c} berarti ${meaning || '—'}. On'yomi ${k.on.join('、') || '—'}, kun'yomi ${k.kun.join('、') || '—'}, ${k.strokes} goresan, lengkap dengan urutan goresan dan contoh kata.`,
  )}
>
  <PageHeader
    title={t(`Kanji ${k.c}`, `Kanji ${k.c}`, `日语汉字 ${k.c}`, `일본 한자 ${k.c}`, `Kanji ${k.c}`)}
    crumbs={[
      { label: t('Kanji', 'Kanji', '汉字', '한자', 'Kanji'), href: l('/kanji') },
      ...(k.jlpt ? [{ label: `N${k.jlpt}`, href: l(`/kanji/jlpt/${jlptSlug(k.jlpt)}`) }] : []),
      { label: k.c },
    ]}
  />

  <section class="container-page grid gap-10 py-10 md:grid-cols-[16rem_1fr]">
    <div>
      {paths.length > 0 ? (
        <StrokeOrder char={k.c} paths={paths} />
      ) : (
        <div class="kanji-box relative mx-auto grid aspect-square w-full max-w-60 place-items-center rounded-2xl border border-line bg-surface md:max-w-none">
          <span lang="ja" class="font-jp text-[9rem] leading-none">{k.c}</span>
        </div>
      )}
      <nav class="mx-auto mt-4 flex max-w-60 justify-between text-sm md:max-w-none" aria-label={t('Kanji trước và sau', 'Previous and next kanji', '上一个和下一个汉字', '이전·다음 한자', 'Kanji sebelum dan sesudahnya')}>
        {prev ? <a href={kanjiUrl(prev.c, lang)} class="link-underline">← <span lang="ja">{prev.c}</span></a> : <span />}
        {next && <a href={kanjiUrl(next.c, lang)} class="link-underline"><span lang="ja">{next.c}</span> →</a>}
      </nav>
    </div>

    <div>
      {lang === 'en' || lang === 'id' ? (
        <>
          <p class="text-sm font-semibold tracking-wide text-fg-muted uppercase">{lang === 'en' ? 'Meaning' : translated ? 'Arti' : 'Arti (bahasa Inggris)'}</p>
          <p lang={meaningLang} class="mt-1 font-serif text-3xl font-bold text-brand">{meaning || '—'}</p>
          {translated && <p lang="en" class="mt-2 text-sm text-fg-muted">English: {meaningEn}</p>}
        </>
      ) : lang === 'zh' || lang === 'ko' ? (
        <>
          {(lang === 'zh' ? py : ko) && (
            <>
              <p class="text-sm font-semibold tracking-wide text-fg-muted uppercase">{lang === 'zh' ? '拼音' : '한국 한자음'}</p>
              <p lang={HTML_LANGS[lang]} class="mt-1 font-serif text-3xl font-bold text-brand">{lang === 'zh' ? py : ko}</p>
            </>
          )}
          <p class="mt-6 text-sm font-semibold tracking-wide text-fg-muted uppercase">
            {lang === 'zh' ? (translated ? '释义' : '释义（英文）') : translated ? '뜻' : '뜻 (영어)'}
          </p>
          <p lang={meaningLang} class="mt-1 text-lg">{meaning || '—'}</p>
          {translated && <p lang="en" class="mt-1 text-sm text-fg-muted">English: {meaningEn}</p>}
        </>
      ) : (
        <>
          {hv && (
            <>
              <p class="text-sm font-semibold tracking-wide text-fg-muted uppercase">Hán Việt</p>
              <p class="mt-1 font-serif text-3xl font-bold text-brand">{hv}</p>
            </>
          )}
          <p class="mt-6 text-sm font-semibold tracking-wide text-fg-muted uppercase">{translated ? 'Nghĩa' : 'Nghĩa (tiếng Anh)'}</p>
          <p lang={meaningLang} class="mt-1 text-lg">{meaning || '—'}</p>
          {translated && <p lang="en" class="mt-1 text-sm text-fg-muted">English: {meaningEn}</p>}
        </>
      )}

      <dl class="mt-8 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-semibold tracking-wide text-fg-muted uppercase">{t('Onyomi (âm On)', "On'yomi", '音读', '음독', "On'yomi")}</dt>
          <dd lang="ja" class="mt-2 flex flex-wrap gap-2">
            {k.on.length ? k.on.map((r) => <span class="rounded-md bg-bg-muted px-2.5 py-1 font-jp text-lg">{r}</span>) : '—'}
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold tracking-wide text-fg-muted uppercase">{t('Kunyomi (âm Kun)', "Kun'yomi", '训读', '훈독', "Kun'yomi")}</dt>
          <dd lang="ja" class="mt-2 flex flex-wrap gap-2">
            {kun.length
              ? kun.map((r) => {
                  // KANJIDIC2 dùng dấu "." để tách phần okurigana, ví dụ た.べる → た(べる)
                  const [stem, oku] = r.split('.');
                  return (
                    <span class="rounded-md bg-bg-muted px-2.5 py-1 font-jp text-lg">
                      {stem}{oku && <span class="text-fg-muted">{oku}</span>}
                    </span>
                  );
                })
              : '—'}
          </dd>
        </div>
      </dl>

      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-3">
        {facts.map(([label, value, href]) => (
          <div class="bg-surface p-4">
            <dt class="text-xs text-fg-muted">{label}</dt>
            <dd class="mt-1 font-semibold">{href ? <a href={href} class="hover:text-brand" lang="ja">{value}</a> : value}</dd>
          </div>
        ))}
      </dl>

      {themes.length > 0 && (
        <p class="mt-6 text-sm text-fg-muted">
          {t('Chủ đề:', 'Themes:', '主题：', '주제:', 'Tema:')}{' '}
          {themes.map((th, i) => (
            <>{i > 0 && ', '}<a href={l(`/kanji/themes/${th.slug}`)} class="link-underline text-fg">{th.name[lang]}</a></>
          ))}
        </p>
      )}
    </div>
  </section>

  {paths.length > 0 && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-6 text-xl font-bold">{t('Thứ tự nét', 'Stroke order', '笔顺', '획순', 'Urutan goresan')}</h2>
        <StrokeSteps char={k.c} count={paths.length} />
      </div>
    </section>
  )}

  <AdSlot placement="kanji" class="border-t border-dashed border-line py-8" />

  {words.length > 0 && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-6 text-xl font-bold">{t('Từ vựng chứa', 'Words with', '含有此字的词语', '이 한자가 들어간 단어', 'Kata yang memakai')} <span lang="ja">{k.c}</span></h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {words.map((w) => {
            const [word, reading, gloss, level] = w;
            const local = wordMeaning(w, lang);
            return (
              <li class="flex items-start gap-4 rounded-xl border border-line bg-surface px-4 py-3">
                <div class="min-w-0 flex-1">
                  <p lang="ja" class="font-jp text-xl">
                    {[...word].map((ch) => (ch === k.c ? <span class="text-brand">{ch}</span> : ch))}
                  </p>
                  <p lang="ja" class="text-sm text-fg-muted">{reading}</p>
                  <p lang={local ? HTML_LANGS[lang] : 'en'} class="mt-1 text-sm">{local ?? gloss}</p>
                </div>
                <a href={l(`/kanji/jlpt/${jlptSlug(level)}`)} class="shrink-0 rounded-full bg-bg-muted px-2 py-0.5 text-xs font-semibold text-fg-muted hover:text-brand">N{level}</a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {sentences.length > 0 && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-6 text-xl font-bold">{t('Câu ví dụ', 'Example sentences', '例句', '예문', 'Contoh kalimat')}</h2>
        <ul class="space-y-4">
          {sentences.map((s) => {
            const tr = sentenceTranslation(s, lang);
            return (
              <li class="rounded-xl border border-line bg-surface px-5 py-4">
                <p lang="ja" class="example font-jp text-xl leading-loose">
                  {s.j.map(([text, reading]) => {
                    // Tô màu chữ đang học trong câu.
                    const body = [...text].map((ch) => (ch === k.c ? <span class="text-brand">{ch}</span> : ch));
                    return reading ? <ruby>{body}<rt>{reading}</rt></ruby> : body;
                  })}
                </p>
                <p lang={tr.fallback ? 'en' : HTML_LANGS[lang]} class="mt-1">{tr.text}</p>
                {(tr.ai || tr.fallback) && (
                  <p class="mt-2 text-xs text-fg-muted">
                    {tr.ai
                      ? t('Bản dịch có hỗ trợ AI', 'AI-assisted translation', '译文由 AI 辅助', 'AI 도움 번역', 'Terjemahan dibantu AI')
                      : t('Chưa có bản dịch tiếng Việt', '', '暂无中文译文', '아직 한국어 번역이 없습니다', 'Belum ada terjemahan bahasa Indonesia')}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {sameRadical.length > 0 && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-6 text-xl font-bold">{t(`Cùng bộ ${radical.name}`, `Other kanji with radical “${radical.nameEn}”`, '同部首汉字：', '같은 부수의 한자:', `Kanji lain dengan radikal “${radical.nameEn}”`)} <span lang="ja">{radical.char}</span></h2>
        <KanjiList kanji={sameRadical} showToggle={false} />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Chữ thập đứt nét như ô tập viết */
  .kanji-box::before,
  .kanji-box::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }
  .kanji-box::before {
    inset: 0 50%;
    border-left: 1px dashed var(--color-line);
  }
  .kanji-box::after {
    inset: 50% 0;
    border-top: 1px dashed var(--color-line);
  }
  /* Furigana trên câu ví dụ */
  .example rt {
    font-size: 0.5em;
    color: var(--color-fg-muted);
  }
</style>
