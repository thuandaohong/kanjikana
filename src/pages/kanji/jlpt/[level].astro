---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import KanjiList from '../../../components/KanjiList.astro';
import { JLPT_LEVELS, byJlpt, jlptSlug } from '../../../data/kanji';
import { getLang, linker, pick } from '../../../i18n';

export function getStaticPaths() {
  return JLPT_LEVELS.map((n) => ({ params: { level: jlptSlug(n) }, props: { n } }));
}
const { n } = Astro.props;
const kanji = byJlpt(n);
const lang = getLang(Astro);
const l = linker(lang);
const t = (vi: string, en: string) => pick(lang, { vi, en });
---
<BaseLayout
  title={`Kanji JLPT N${n}`}
  description={t(
    `Danh sách ${kanji.length} kanji JLPT N${n} kèm âm Hán Việt, nghĩa và cách đọc.`,
    `All ${kanji.length} JLPT N${n} kanji with meanings and readings.`,
  )}
>
  <PageHeader
    title={`Kanji JLPT N${n}`}
    crumbs={[{ label: 'Kanji', href: l('/kanji') }, { label: 'JLPT', href: l('/kanji/jlpt') }, { label: `N${n}` }]}
    lead={t(
      `${kanji.length} kanji cho cấp N${n}, xếp theo độ thông dụng. Bấm vào một chữ để xem chi tiết.`,
      `${kanji.length} kanji for level N${n}, ordered by frequency. Click a character for details.`,
    )}
  >
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={t('Cấp JLPT khác', 'Other JLPT levels')}>
      {JLPT_LEVELS.map((m) => (
        <a
          href={l(`/kanji/jlpt/${jlptSlug(m)}`)}
          aria-current={m === n ? 'page' : undefined}
          class="rounded-full border border-line px-4 py-1.5 text-sm font-semibold hover:border-brand aria-[current=page]:border-brand aria-[current=page]:bg-brand aria-[current=page]:text-white"
        >N{m}</a>
      ))}
    </nav>
  </PageHeader>
  <section class="container-page py-10">
    <KanjiList kanji={kanji} />
  </section>
</BaseLayout>
