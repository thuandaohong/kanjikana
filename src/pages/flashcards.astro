---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getLang, linker, pick } from '../i18n';

const lang = getLang(Astro);
const t = (vi: string, en: string, zh: string, ko: string, id: string) => pick(lang, { vi, en, zh, ko, id });
// Chuỗi cho script phía trình duyệt; {n}, {known}, {total}, {deck} được thay khi hiển thị.
const strings = {
  lang,
  kanjiBase: linker(lang)('/kanji/'),
  deckInfo: t('{n} thẻ · đã thuộc {known}/{n}', '{n} cards · {known}/{n} learned', '{n} 张卡片 · 已掌握 {known}/{n}', '카드 {n}장 · {known}/{n} 외움', '{n} kartu · {known}/{n} sudah hafal'),
  allKnown: t(
    'Bạn đã thuộc hết bộ này. Bỏ chọn “Chỉ ôn những chữ chưa thuộc” để ôn lại.',
    'You have learned every card in this deck. Untick “Only cards I haven’t learned” to review them again.',
    '这套卡片你已全部掌握。取消勾选“只复习还没掌握的卡片”即可重新复习。',
    '이 덱의 카드를 모두 외웠습니다. 다시 복습하려면 “아직 못 외운 카드만”의 체크를 해제하세요.',
    'Kamu sudah menghafal semua kartu di dek ini. Hapus centang “Hanya kartu yang belum hafal” untuk mengulang lagi.',
  ),
  remaining: t('Còn {n} thẻ', '{n} cards left', '还剩 {n} 张', '{n}장 남음', 'Sisa {n} kartu'),
  details: t('Xem chi tiết', 'Details', '查看详情', '자세히 보기', 'Lihat detail'),
  summary: t('Bạn đã ôn xong {total} thẻ của bộ {deck}.', 'You reviewed all {total} cards in {deck}.', '你已复习完 {deck} 的全部 {total} 张卡片。', '{deck}의 카드 {total}장을 모두 복습했습니다.', 'Kamu sudah mengulang semua {total} kartu di {deck}.'),
  confirmReset: t('Xoá tiến độ của bộ {deck}?', 'Reset progress for {deck}?', '清除 {deck} 的学习进度？', '{deck}의 진도를 초기화할까요?', 'Hapus progres untuk {deck}?'),
  error: t('Không tải được dữ liệu. Hãy thử tải lại trang.', 'Could not load data. Please reload the page.', '无法加载数据，请刷新页面重试。', '데이터를 불러오지 못했습니다. 페이지를 새로고침해 주세요.', 'Gagal memuat data. Silakan muat ulang halaman.'),
};
---
<BaseLayout
  title={t('Flashcards kanji', 'Kanji flashcards', '汉字闪卡', '한자 플래시카드', 'Flashcard kanji')}
  description={t(
    'Ôn kanji bằng flashcards theo cấp JLPT, Kanken hoặc chủ đề. Tiến độ được lưu trên trình duyệt.',
    'Review kanji with flashcards by JLPT level, Kanken level or theme. Progress is saved in your browser.',
    '按 JLPT 级别、汉检级别或主题用闪卡复习汉字，进度保存在你的浏览器中。',
    'JLPT 급수, 한자검정 급수, 주제별로 플래시카드로 한자를 복습하세요. 진도는 브라우저에 저장됩니다.',
    'Ulangi kanji dengan flashcard per level JLPT, level Kanken, atau tema. Progres disimpan di browser kamu.',
  )}
>
  <script is:inline type="application/json" id="page-strings" set:html={JSON.stringify(strings)} />
  <PageHeader
    title={t('Flashcards', 'Flashcards', '闪卡', '플래시카드', 'Flashcard')}
    crumbs={[{ label: t('Công cụ', 'Tools', '工具', '도구', 'Alat') }, { label: t('Flashcards', 'Flashcards', '闪卡', '플래시카드', 'Flashcard') }]}
    lead={t(
      'Chọn một bộ thẻ, lật thẻ để xem đáp án, rồi đánh dấu đã nhớ hoặc chưa nhớ. Thẻ chưa nhớ sẽ quay lại sau vài lượt.',
      'Pick a deck, flip a card to see the answer, then mark whether you knew it. Cards you missed come back after a few turns.',
      '选择一套卡片，翻开卡片查看答案，再标记是否记住。没记住的卡片过几轮会再出现。',
      '덱을 고르고 카드를 뒤집어 답을 확인한 뒤, 외웠는지 표시하세요. 못 외운 카드는 몇 장 뒤에 다시 나옵니다.',
      'Pilih dek, balik kartu untuk melihat jawaban, lalu tandai apakah kamu sudah hafal. Kartu yang belum hafal akan muncul lagi setelah beberapa giliran.',
    )}
  />

  <section class="container-page py-10">
    <!-- Bước 1: chọn bộ thẻ -->
    <form id="fc-setup" class="max-w-xl space-y-5">
      <div>
        <label for="fc-deck" class="mb-1.5 block text-sm font-semibold">{t('Bộ thẻ', 'Deck', '卡片组', '덱', 'Dek')}</label>
        <select id="fc-deck" class="h-11 w-full rounded-lg border border-line bg-surface px-3" disabled>
          <option>{t('Đang tải…', 'Loading…', '加载中…', '불러오는 중…', 'Memuat…')}</option>
        </select>
        <p id="fc-deck-info" class="mt-2 text-sm text-fg-muted"></p>
      </div>
      <fieldset>
        <legend class="mb-1.5 text-sm font-semibold">{t('Mặt trước', 'Front of card', '卡片正面', '카드 앞면', 'Sisi depan kartu')}</legend>
        <div class="flex flex-wrap gap-4 text-sm">
          <label class="inline-flex items-center gap-2"><input type="radio" name="mode" value="kanji" checked class="accent-brand" /> {t('Kanji → nghĩa', 'Kanji → meaning', '汉字 → 读音与释义', '한자 → 한자음·뜻', 'Kanji → arti')}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="mode" value="meaning" class="accent-brand" /> {t('Hán Việt, nghĩa → kanji', 'Meaning → kanji', '拼音、释义 → 汉字', '한자음·뜻 → 한자', 'Arti → kanji')}</label>
        </div>
      </fieldset>
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" id="fc-only-new" checked class="size-4 accent-brand" /> {t('Chỉ ôn những chữ chưa thuộc', 'Only cards I haven’t learned', '只复习还没掌握的卡片', '아직 못 외운 카드만', 'Hanya kartu yang belum hafal')}
      </label>
      <div class="flex flex-wrap gap-3">
        <button type="submit" class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white hover:opacity-90 disabled:opacity-50">{t('Bắt đầu', 'Start', '开始', '시작', 'Mulai')}</button>
        <button type="button" id="fc-reset" class="rounded-lg border border-line px-4 py-2.5 text-sm hover:border-brand">{t('Xoá tiến độ bộ này', 'Reset this deck', '清除本组进度', '이 덱 초기화', 'Reset dek ini')}</button>
      </div>
    </form>

    <!-- Bước 2: học -->
    <div id="fc-study" hidden class="mx-auto max-w-xl">
      <div class="mb-4 flex items-center justify-between text-sm text-fg-muted">
        <span id="fc-deck-name"></span>
        <span id="fc-count"></span>
      </div>
      <div class="mb-6 h-1.5 overflow-hidden rounded-full bg-bg-muted">
        <div id="fc-bar" class="h-full rounded-full bg-brand transition-[width]"></div>
      </div>

      <button
        type="button"
        id="fc-card"
        class="flex min-h-80 w-full flex-col items-center justify-center rounded-2xl border border-line bg-surface p-8 text-center shadow-sm transition hover:border-brand/50"
        aria-live="polite"
      >
        <div id="fc-front"></div>
        <div id="fc-back" hidden class="mt-6 w-full border-t border-dashed border-line pt-6"></div>
        <span id="fc-hint" class="mt-6 text-xs text-fg-muted">{t('Bấm vào thẻ hoặc nhấn phím cách để lật', 'Click the card or press Space to flip', '点击卡片或按空格键翻面', '카드를 누르거나 스페이스 키로 뒤집기', 'Klik kartu atau tekan Spasi untuk membalik')}</span>
      </button>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <button type="button" id="fc-again" disabled class="rounded-lg border border-line py-3 font-semibold hover:border-brand disabled:opacity-40">
          {t('Chưa nhớ', 'Again', '没记住', '다시', 'Belum hafal')} <span class="text-xs text-fg-muted">(1)</span>
        </button>
        <button type="button" id="fc-good" disabled class="rounded-lg bg-brand py-3 font-semibold text-white hover:opacity-90 disabled:opacity-40">
          {t('Đã nhớ', 'Got it', '记住了', '외웠어요', 'Sudah hafal')} <span class="text-xs opacity-80">(2)</span>
        </button>
      </div>
      <button type="button" id="fc-quit" class="link-underline mt-6 text-sm">← {t('Chọn bộ khác', 'Choose another deck', '选择其他卡片组', '다른 덱 고르기', 'Pilih dek lain')}</button>
    </div>

    <!-- Bước 3: kết thúc -->
    <div id="fc-done" hidden class="mx-auto max-w-xl rounded-2xl border border-line bg-surface p-8 text-center">
      <p class="font-jp text-6xl">完</p>
      <h2 class="mt-4 text-2xl font-bold">{t('Hoàn thành!', 'Done!', '完成！', '완료!', 'Selesai!')}</h2>
      <p id="fc-summary" class="mt-2 text-fg-muted"></p>
      <div class="mt-6 flex justify-center gap-3">
        <button type="button" id="fc-restart" class="rounded-lg bg-brand px-5 py-2.5 font-semibold text-white hover:opacity-90">{t('Ôn lại', 'Review again', '再复习一遍', '다시 복습', 'Ulangi lagi')}</button>
        <button type="button" id="fc-back-setup" class="rounded-lg border border-line px-5 py-2.5 hover:border-brand">{t('Chọn bộ khác', 'Choose another deck', '选择其他卡片组', '다른 덱 고르기', 'Pilih dek lain')}</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Entry = { c: string; hv: string[]; py: string[]; ko: string[]; en: string[]; on: string[]; kun: string[]; jlpt: number | null; m?: string };
  type Deck = { id: string; group: Record<string, string>; name: Record<string, string>; chars: string };

  const S = JSON.parse(document.getElementById('page-strings')!.textContent!);
  const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k]));
  const deckName = (d: Deck) => d.name[S.lang];

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const setup = $<HTMLFormElement>('fc-setup');
  const study = $('fc-study');
  const done = $('fc-done');
  const deckSelect = $<HTMLSelectElement>('fc-deck');
  const onlyNew = $<HTMLInputElement>('fc-only-new');
  const card = $<HTMLButtonElement>('fc-card');
  const front = $('fc-front');
  const back = $('fc-back');
  const btnAgain = $<HTMLButtonElement>('fc-again');
  const btnGood = $<HTMLButtonElement>('fc-good');

  // ---------- Lưu trữ (localStorage, có thể không dùng được) ----------
  const store = {
    get(key: string): string | null {
      try { return localStorage.getItem(key); } catch { return null; }
    },
    set(key: string, value: string) {
      try { localStorage.setItem(key, value); } catch {}
    },
  };
  const knownKey = (deck: Deck) => `fc-known:${deck.id}`;
  const getKnown = (deck: Deck) => new Set([...(store.get(knownKey(deck)) ?? '')]);
  const saveKnown = (deck: Deck, set: Set<string>) => store.set(knownKey(deck), [...set].join(''));

  let byChar = new Map<string, Entry>();
  let decks: Deck[] = [];
  let deck: Deck;
  let queue: string[] = [];
  let total = 0;
  let learned = 0;
  let flipped = false;
  let mode: 'kanji' | 'meaning' = 'kanji';

  const currentDeck = () => decks.find((d) => d.id === deckSelect.value)!;

  function showDeckInfo() {
    const d = currentDeck();
    const known = getKnown(d);
    const n = [...d.chars].length;
    $('fc-deck-info').textContent = fill(S.deckInfo, { n, known: [...d.chars].filter((c) => known.has(c)).length });
    store.set('fc-last-deck', d.id);
  }

  function shuffle<T>(a: T[]) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function el(tag: string, cls: string, text: string, ja = false) {
    const e = document.createElement(tag);
    e.className = cls;
    e.textContent = text;
    if (ja) e.lang = 'ja';
    return e;
  }

  function start() {
    deck = currentDeck();
    mode = (new FormData(setup).get('mode') as 'kanji' | 'meaning') ?? 'kanji';
    const known = getKnown(deck);
    let chars = [...deck.chars].filter((c) => byChar.has(c));
    if (onlyNew.checked) chars = chars.filter((c) => !known.has(c));
    if (!chars.length) {
      $('fc-deck-info').textContent = S.allKnown;
      return;
    }
    queue = shuffle(chars);
    total = queue.length;
    learned = 0;
    $('fc-deck-name').textContent = deckName(deck);
    setup.hidden = true;
    done.hidden = true;
    study.hidden = false;
    showCard();
  }

  function showCard() {
    if (!queue.length) return finish();
    const k = byChar.get(queue[0])!;
    flipped = false;
    btnAgain.disabled = btnGood.disabled = true;
    back.hidden = true;
    $('fc-hint').hidden = false;
    $('fc-count').textContent = fill(S.remaining, { n: queue.length });
    $('fc-bar').style.width = `${(learned / total) * 100}%`;

    const meaning = k.m ?? k.en.slice(0, 3).join(', ');
    // Âm đọc của người học (Hán Việt, pinyin, âm Hán-Hàn) là gợi ý chính, nghĩa là phụ.
    // Tiếng Anh và tiếng Indonesia không có âm đọc riêng: chỉ dùng nghĩa.
    const local: string[] | undefined = ({ vi: k.hv, zh: k.py, ko: k.ko } as Record<string, string[]>)[S.lang];
    const primary = (local ? local.join(', ') : meaning) || '—';
    const secondary = local ? meaning : '';
    if (mode === 'kanji') {
      front.replaceChildren(el('p', 'font-jp text-8xl leading-none', k.c, true));
    } else {
      front.replaceChildren(
        el('p', 'font-serif text-3xl font-bold text-brand', primary),
        el('p', 'mt-2 text-lg', secondary),
      );
    }

    const details = [
      mode === 'kanji'
        ? el('p', 'font-serif text-2xl font-bold text-brand', primary)
        : el('p', 'font-jp text-7xl leading-none', k.c, true),
      el('p', 'mt-2 text-fg-muted', mode === 'kanji' ? secondary : ''),
      el('p', 'mt-3 text-sm', [...k.on, ...k.kun].slice(0, 6).join('、'), true),
    ];
    const link = el('a', 'link-underline mt-4 inline-block text-sm', S.details) as HTMLAnchorElement;
    link.href = S.kanjiBase + k.c;
    link.target = '_blank';
    back.replaceChildren(...details, link);
  }

  function flip() {
    if (flipped || study.hidden) return;
    flipped = true;
    back.hidden = false;
    $('fc-hint').hidden = true;
    btnAgain.disabled = btnGood.disabled = false;
    btnGood.focus({ preventScroll: true });
  }

  function answer(good: boolean) {
    if (!flipped) return;
    const c = queue.shift()!;
    if (good) {
      learned++;
      const known = getKnown(deck);
      known.add(c);
      saveKnown(deck, known);
    } else {
      // Đưa thẻ quay lại sau 3–6 lượt.
      queue.splice(Math.min(queue.length, 3 + Math.floor(Math.random() * 4)), 0, c);
    }
    showCard();
  }

  function finish() {
    study.hidden = true;
    done.hidden = false;
    $('fc-summary').textContent = fill(S.summary, { total, deck: deckName(deck) });
  }

  function backToSetup() {
    study.hidden = done.hidden = true;
    setup.hidden = false;
    showDeckInfo();
  }

  setup.addEventListener('submit', (e) => {
    e.preventDefault();
    start();
  });
  deckSelect.addEventListener('change', showDeckInfo);
  $('fc-reset').addEventListener('click', () => {
    const d = currentDeck();
    if (confirm(fill(S.confirmReset, { deck: deckName(d) }))) {
      saveKnown(d, new Set());
      showDeckInfo();
    }
  });
  card.addEventListener('click', flip);
  btnAgain.addEventListener('click', () => answer(false));
  btnGood.addEventListener('click', () => answer(true));
  $('fc-quit').addEventListener('click', backToSetup);
  $('fc-back-setup').addEventListener('click', backToSetup);
  $('fc-restart').addEventListener('click', () => {
    onlyNew.checked = false;
    start();
  });
  document.addEventListener('keydown', (e) => {
    if (study.hidden || e.target instanceof HTMLInputElement || e.target instanceof HTMLSelectElement) return;
    if (e.key === ' ' || e.key === 'Enter') {
      e.preventDefault();
      flip();
    } else if (e.key === '1' || e.key === 'ArrowLeft') answer(false);
    else if (e.key === '2' || e.key === 'ArrowRight') answer(true);
  });

  // Bản không phải tiếng Anh tải thêm nghĩa đã dịch của ngôn ngữ đó.
  Promise.all([
    fetch('/data/kanji.json').then((r) => r.json()),
    S.lang === 'en' ? {} : fetch(`/data/meanings/${S.lang}.json`).then((r) => r.json()),
  ])
    .then(([json, meanings]: [{ kanji: Entry[]; decks: Deck[] }, Record<string, string>]) => {
      byChar = new Map(json.kanji.map((k) => [k.c, { ...k, m: meanings[k.c] }]));
      decks = json.decks;
      const groups = new Map<string, HTMLOptGroupElement>();
      deckSelect.replaceChildren();
      for (const d of decks) {
        const group = d.group[S.lang];
        if (!groups.has(group)) {
          const g = document.createElement('optgroup');
          g.label = group;
          groups.set(group, g);
          deckSelect.append(g);
        }
        groups.get(group)!.append(new Option(deckName(d), d.id));
      }
      const last = store.get('fc-last-deck');
      if (last && decks.some((d) => d.id === last)) deckSelect.value = last;
      deckSelect.disabled = false;
      showDeckInfo();
    })
    .catch(() => ($('fc-deck-info').textContent = S.error));
</script>
